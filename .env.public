# Git clone / branch
BRANCH=run-clean-setup
GIT_USER_EMAIL=bestrun@test.com
GIT_USER_NAME="base run"

# Claude Code automation
OLLAMA_MODEL=kimi-k2.6:cloud
PROMPT="Read the prompt.md file and follow the instructions"

# Ollama configuration
# For containerized Ollama (default): use ai-dev-env service
# For host Ollama: use ai-dev-env-local-ollama service
# ANTHROPIC_BASE_URL is set automatically in compose; override here if needed
